# =============================================================================
# Show Portal — environment variables
# =============================================================================
# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is gitignored — never commit real secrets.
#
# Where to find each value in the Supabase dashboard:
#   Project Settings → API   → NEXT_PUBLIC_SUPABASE_URL
#   Project Settings → API   → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Project Settings → API   → SUPABASE_SERVICE_ROLE_KEY   (keep server-only!)
#   Project Settings → Database → Connection string → URI (Transaction pooler)
#                             → DATABASE_URL
# =============================================================================

# Public URL of your Supabase project (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anonymous / public API key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key (SERVER-ONLY, never expose to the browser).
# Only used from server-side code with elevated privileges.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string for Drizzle (use the TRANSACTION POOLER URI).
# Looks like: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Your app's public URL (used for password reset redirect links).
# Production: https://proscene.app
# Local dev:  http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Resend — email sending
# =============================================================================
# API key from resend.com dashboard → API Keys.
# For Supabase custom SMTP (Auth → SMTP Settings) the same key is used as
# the SMTP password with user=resend, host=smtp.resend.com, port=465.
RESEND_API_KEY=re_your_api_key_here

# Sender address. Production uses the verified Proscene sending domain
# (see docs/decision-log.md 2026-05-27). To test from an unverified env
# without owning the domain, override locally with:
#   RESEND_FROM_EMAIL=onboarding@resend.dev
# (sandbox sender only delivers to your own Resend account).
RESEND_FROM_EMAIL=noreply@proscene.app

# =============================================================================
# Web Push — PWA phone/desktop push notifications
# =============================================================================
# Generate a keypair ONCE and reuse it forever (rotating it invalidates every
# existing device subscription):
#   npx web-push generate-vapid-keys
# Add all three to Vercel (Production AND Preview) and to your local .env.local.
#
# The PUBLIC key is shipped to the browser (NEXT_PUBLIC_); the PRIVATE key is
# server-only — never prefix it with NEXT_PUBLIC_ or expose it to the client.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact URI push services can reach you at (mailto: or your site URL).
VAPID_SUBJECT=mailto:notifications@proscene.app

# =============================================================================
# Anthropic — AI script analysis
# =============================================================================
# API key from console.anthropic.com → API Keys. Server-only; used to parse
# uploaded scripts into a cast list, scene breakdown, and bookmarks
# (features/scripts/parse.ts). If unset, the "Analyze with AI" action fails
# gracefully with a "not configured" message — nothing else is affected.
ANTHROPIC_API_KEY=sk-ant-your-api-key

# =============================================================================
# Stripe — subscription billing
# =============================================================================
# All server-only. The app builds and runs WITHOUT these (the billing page just
# shows "online billing isn't available yet"); set them to turn on Checkout.
# The whole paywall is additionally gated behind BILLING_ENABLED in
# features/billing/constants.ts — that must be `true` for any of this to fire.
#
# Use TEST (sandbox) keys for staging; swap to LIVE keys only when ready to
# actually charge.
#   Secret key:     Developers -> API keys -> Secret key  (sk_test_… / sk_live_…)
#   Webhook secret: Developers -> Webhooks -> your endpoint -> Signing secret
#                   Endpoint URL: https://<your-site>/api/stripe/webhook
#                   Events: checkout.session.completed,
#                           customer.subscription.created / updated / deleted
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret

# Recurring PRICE ids (price_…, NOT product prod_… ids). One per plan x interval.
# Create three Products (Season / Repertory / Company), each with a monthly and
# an annual recurring price, then paste the price ids here. Do NOT configure a
# trial on the Stripe price — the app owns the 60-day trial and passes trial_end
# at checkout. Amounts (USD): Season $25/mo, $249/yr · Repertory $49/mo, $499/yr
# · Company $79/mo, $799/yr.
STRIPE_PRICE_SEASON_MONTHLY=price_...
STRIPE_PRICE_SEASON_ANNUAL=price_...
STRIPE_PRICE_REPERTORY_MONTHLY=price_...
STRIPE_PRICE_REPERTORY_ANNUAL=price_...
STRIPE_PRICE_COMPANY_MONTHLY=price_...
STRIPE_PRICE_COMPANY_ANNUAL=price_...

# Designer-seat ("Proscene Studio") recurring PRICE ids — the per-USER plans,
# separate products from the org plans above. Three tiers x {monthly, annual}.
# Same rules: real price_… ids, no trial on the Stripe price. Amounts (USD):
# Single Tool $5.99/mo, $59/yr · Studio $9.99/mo, $99/yr · Studio Pro $14.99/mo,
# $149/yr. The same webhook (/api/stripe/webhook) handles these — no separate
# endpoint needed.
STRIPE_PRICE_SINGLE_TOOL_MONTHLY=price_...
STRIPE_PRICE_SINGLE_TOOL_ANNUAL=price_...
STRIPE_PRICE_STUDIO_MONTHLY=price_...
STRIPE_PRICE_STUDIO_ANNUAL=price_...
STRIPE_PRICE_STUDIO_PRO_MONTHLY=price_...
STRIPE_PRICE_STUDIO_PRO_ANNUAL=price_...

# ── Marketing site (Sanity CMS) ──────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=dsciikio
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only read token. REQUIRED for the Studio's Visual Editing / Presentation
# pane to show unpublished drafts and the click-to-edit overlays. Create one at
# sanity.io/manage → project → API → Tokens with the "Viewer" role, then add it
# here and to Vercel. Without it, published content still previews but drafts
# won't load. Never prefix with NEXT_PUBLIC_ — it must stay off the client.
SANITY_API_READ_TOKEN=
NEXT_PUBLIC_DEMO_SCHEDULER_URL=
CONTACT_EMAIL=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Inert until set.
NEXT_PUBLIC_GTM_ID=

# =============================================================================
# Sentry — error monitoring
# =============================================================================
# DSN from sentry.io → (your project) → Settings → Client Keys (DSN).
# Without this the app runs normally — no errors are sent to Sentry.
# Safe to expose to the browser (it's a write-only ingest key).
NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# Upstash Redis — rate limiting
# =============================================================================
# From upstash.com → your Redis database → REST API.
# Without these, rate limiting is silently skipped (safe for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
